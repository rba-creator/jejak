# Salin menjadi .env.local. Jangan commit file .env.local.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# BIG/Piksel WMS. Isi setelah mengecek GetCapabilities dan memastikan
# layer RBI yang sesuai tersedia serta ketentuan pemakaiannya.
VITE_RBI_WMS_URL=https://ows.piksel.big.go.id/wms
VITE_RBI_WMS_LAYERS=
VITE_RBI_WMS_FORMAT=image/png
VITE_RBI_WMS_TRANSPARENT=true
